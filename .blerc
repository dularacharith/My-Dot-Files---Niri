# ble.sh configuration (Bash Line Editor & Autosuggestions)

# Instant autosuggestions as you type
bleopt complete_auto_delay=0

# Only suggest history entries whose arguments (paths) are valid from the current directory
bleopt complete_auto_history=

# Prioritize completion-based suggestions over history
bleopt complete_auto_complete=1

# Syntax highlighting
bleopt highlight_syntax=1

# Disable audible bell
bleopt edit_abell=0

# Auto-complete styling: clean dimmed ghost text matching dark terminal
ble-face -s auto_complete fg=243
ble-face -s command_builtin_dot fg=141
ble-face -s command_alias fg=111
ble-face -s command_function fg=111
ble-face -s command_directory fg=75
ble-face -s syntax_error fg=203

# ── Interactive completion menu ──────────────────────────────────
# Show menu list on first Tab press (not just inline completion)
bleopt complete_menu_complete=1

# Menu style: align items in a navigable column list
bleopt complete_menu_style=align-nowrap

# Show completion menu immediately with filtering
bleopt complete_menu_filter=1

# Max height for the completion menu (rows)
bleopt complete_menu_maxlines=20

# Menu colors: subtle styling for dark terminal
ble-face -s menu_filter_fixed fg=75
ble-face -s menu_filter_input fg=252,bold

# Bind arrow keys and Enter in menu for navigation & selection
ble-bind -m auto_complete -f up     auto_complete/cancel
ble-bind -m auto_complete -f down   auto_complete/cancel
ble-bind -m auto_complete -f C-e    auto_complete/insert

