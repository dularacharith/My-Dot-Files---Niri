#!/usr/bin/env bash
# fn-feedback: Fast visual OSD feedback for keyboard function keys in Niri / DMS
# Displays pill-shaped top toast messages with matching Material icons via DMS ToastService.

action="${1:-}"
sub="${2:-}"

show_toast() {
    local msg="$1"
    local icon="${2:-info}"
    local level="${3:-info}"

    if ! dms ipc call toast "${level}With" "$msg" "" "" "$icon" >/dev/null 2>&1; then
        notify-send -a "System" -t 1500 "$msg"
    fi
}

case "$action" in
    touchpad)
        TOUCHPAD_CONF="$HOME/.config/niri/touchpad.kdl"
        mkdir -p "$(dirname "$TOUCHPAD_CONF")"
        
        target_mode="$sub"
        if [ -z "$target_mode" ] || [ "$target_mode" = "toggle" ]; then
            if [ -f "$TOUCHPAD_CONF" ] && grep -q "off" "$TOUCHPAD_CONF"; then
                target_mode="on"
            else
                target_mode="off"
            fi
        fi

        if [ "$target_mode" = "off" ]; then
            printf "input {\n    touchpad {\n        off\n    }\n}\n" > "$TOUCHPAD_CONF"
            show_toast "Touchpad: Off" "touchpad_mouse_off"
            niri msg action load-config-file >/dev/null 2>&1
        else
            printf "input {\n    touchpad {\n        tap\n        natural-scroll\n        accel-speed 0.0\n        scroll-factor 0.5\n    }\n}\n" > "$TOUCHPAD_CONF"
            show_toast "Touchpad: On" "touchpad_mouse"
            niri msg action load-config-file >/dev/null 2>&1
        fi
        ;;

    volume)
        # Volume is handled natively by DMS OSD
        case "$sub" in
            mute|toggle-mute)
                exec dms ipc call audio mute
                ;;
            up|inc|increment)
                exec dms ipc call audio increment 3
                ;;
            down|dec|decrement)
                exec dms ipc call audio decrement 3
                ;;
        esac
        ;;

    mic)
        # Mic is handled natively by DMS OSD
        exec dms ipc call audio micmute
        ;;

    brightness)
        # Brightness is handled natively by DMS OSD with adaptive stepping
        exec brightness-step "$sub"
        ;;

    airplane)
        wifi_status=$(nmcli radio wifi 2>/dev/null)
        if [ "$wifi_status" = "enabled" ]; then
            nmcli radio wifi off >/dev/null 2>&1
            show_toast "Airplane Mode: On" "airplanemode_active"
        else
            nmcli radio wifi on >/dev/null 2>&1
            show_toast "Airplane Mode: Off" "wifi"
        fi
        ;;

    display)
        dms ipc call outputs cycleProfile >/dev/null 2>&1
        show_toast "Display Profile Switched" "desktop_windows"
        ;;

    media)
        case "$sub" in
            play-pause)
                dms ipc call mpris playPause >/dev/null 2>&1
                sleep 0.05
                m_status=$(playerctl status 2>/dev/null)
                m_title=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null)
                if [ "$m_status" = "Playing" ]; then
                    show_toast "Media Playing: ${m_title:-Playing}" "play_arrow"
                else
                    show_toast "Media: Paused" "pause"
                fi
                ;;
            next)
                dms ipc call mpris next >/dev/null 2>&1
                sleep 0.05
                m_title=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null)
                show_toast "Next Track: ${m_title:-Next}" "skip_next"
                ;;
            prev)
                dms ipc call mpris previous >/dev/null 2>&1
                sleep 0.05
                m_title=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null)
                show_toast "Previous Track: ${m_title:-Previous}" "skip_previous"
                ;;
            stop)
                playerctl stop 2>/dev/null || dms ipc call mpris stop >/dev/null 2>&1
                show_toast "Media: Stopped" "stop"
                ;;
        esac
        ;;

    *)
        echo "Usage: $0 {touchpad [toggle|on|off]|volume [up|down|mute]|mic [mute]|brightness [up|down]|airplane [toggle]|display|media [play-pause|next|prev|stop]}" >&2
        exit 1
        ;;
esac
