#!/usr/bin/env bash
# fn-feedback: Fast visual OSD feedback for keyboard function keys in Niri / DMS
# Sends synchronous notifications with freedesktop icons and percentage progress bars.

action="${1:-}"
sub="${2:-}"

notify_osd() {
    local tag="$1"
    local icon="$2"
    local title="$3"
    local body="$4"
    local value="${5:-}"

    if [ -n "$value" ]; then
        notify-send -a "System" -i "$icon" \
            -h "string:x-canonical-private-synchronous:$tag" \
            -h "int:value:$value" \
            -t 1500 \
            "$title" "$body"
    else
        notify-send -a "System" -i "$icon" \
            -h "string:x-canonical-private-synchronous:$tag" \
            -t 1500 \
            "$title" "$body"
    fi
}

case "$action" in
    touchpad)
        TOUCHPAD_CONF="$HOME/.config/niri/touchpad.kdl"
        mkdir -p "$(dirname "$TOUCHPAD_CONF")"
        
        target_mode="$sub"
        if [ -z "$target_mode" ] || [ "$target_mode" = "toggle" ]; then
            if [ -f "$TOUCHPAD_CONF" ] && grep -q "off" "$TOUCHPAD_CONF"; then
                target_mode="on"
            else
                target_mode="off"
            fi
        fi

        if [ "$target_mode" = "off" ]; then
            printf "input {\n    touchpad {\n        off\n    }\n}\n" > "$TOUCHPAD_CONF"
            niri msg action load-config-file >/dev/null 2>&1
            notify_osd "osd-touchpad" "touchpad-disabled-symbolic" "Touchpad" "Touchpad Off"
        else
            printf "input {\n    touchpad {\n    }\n}\n" > "$TOUCHPAD_CONF"
            niri msg action load-config-file >/dev/null 2>&1
            notify_osd "osd-touchpad" "input-touchpad-symbolic" "Touchpad" "Touchpad On"
        fi
        ;;

    volume)
        case "$sub" in
            mute|toggle-mute)
                dms ipc call audio mute >/dev/null 2>&1
                sink_info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
                if [[ "$sink_info" =~ \[MUTED\] ]]; then
                    notify_osd "osd-volume" "audio-volume-muted-symbolic" "Volume" "Muted"
                else
                    raw_vol=$(echo "$sink_info" | awk '{print $2}')
                    vol=$(awk -v v="$raw_vol" 'BEGIN { printf "%.0f", v * 100 }')
                    notify_osd "osd-volume" "audio-volume-high-symbolic" "Volume" "$vol%" "$vol"
                fi
                ;;
            up|inc|increment)
                dms ipc call audio increment 3 >/dev/null 2>&1
                sink_info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
                raw_vol=$(echo "$sink_info" | awk '{print $2}')
                vol=$(awk -v v="$raw_vol" 'BEGIN { printf "%.0f", v * 100 }')
                [ "$vol" -gt 100 ] && vol=100
                if [ "$vol" -lt 35 ]; then
                    icon="audio-volume-low-symbolic"
                elif [ "$vol" -lt 70 ]; then
                    icon="audio-volume-medium-symbolic"
                else
                    icon="audio-volume-high-symbolic"
                fi
                notify_osd "osd-volume" "$icon" "Volume" "$vol%" "$vol"
                ;;
            down|dec|decrement)
                dms ipc call audio decrement 3 >/dev/null 2>&1
                sink_info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
                raw_vol=$(echo "$sink_info" | awk '{print $2}')
                vol=$(awk -v v="$raw_vol" 'BEGIN { printf "%.0f", v * 100 }')
                [ "$vol" -lt 0 ] && vol=0
                if [ "$vol" -eq 0 ]; then
                    icon="audio-volume-muted-symbolic"
                elif [ "$vol" -lt 35 ]; then
                    icon="audio-volume-low-symbolic"
                elif [ "$vol" -lt 70 ]; then
                    icon="audio-volume-medium-symbolic"
                else
                    icon="audio-volume-high-symbolic"
                fi
                notify_osd "osd-volume" "$icon" "Volume" "$vol%" "$vol"
                ;;
        esac
        ;;

    mic)
        dms ipc call audio micmute >/dev/null 2>&1
        source_info=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
        if [[ "$source_info" =~ \[MUTED\] ]]; then
            notify_osd "osd-mic" "microphone-sensitivity-muted-symbolic" "Microphone" "Muted"
        else
            notify_osd "osd-mic" "audio-input-microphone-symbolic" "Microphone" "On"
        fi
        ;;

    brightness)
        # Call existing brightness-step script for adaptive stepping
        brightness-step "$sub" >/dev/null 2>&1
        
        # Query current brightness
        b_status=$(dms ipc call brightness status 2>/dev/null)
        if [[ "$b_status" =~ ([0-9]+)% ]]; then
            cur="${BASH_REMATCH[1]}"
        elif [ -r /sys/class/backlight/intel_backlight/brightness ] && [ -r /sys/class/backlight/intel_backlight/max_brightness ]; then
            raw=$(< /sys/class/backlight/intel_backlight/brightness)
            max=$(< /sys/class/backlight/intel_backlight/max_brightness)
            cur=$(( (raw * 100 + max / 2) / max ))
        else
            cur=50
        fi
        notify_osd "osd-brightness" "display-brightness-symbolic" "Brightness" "$cur%" "$cur"
        ;;

    airplane)
        wifi_status=$(nmcli radio wifi 2>/dev/null)
        if [ "$wifi_status" = "enabled" ]; then
            nmcli radio wifi off >/dev/null 2>&1
            notify_osd "osd-airplane" "airplane-mode-symbolic" "Airplane Mode" "Enabled (Wi-Fi Off)"
        else
            nmcli radio wifi on >/dev/null 2>&1
            notify_osd "osd-airplane" "network-wireless-signal-excellent-symbolic" "Wi-Fi" "Enabled (Airplane Mode Off)"
        fi
        ;;

    display)
        dms ipc call outputs cycleProfile >/dev/null 2>&1
        notify_osd "osd-display" "video-display-symbolic" "Display" "Display Profile Switched"
        ;;

    media)
        case "$sub" in
            play-pause)
                dms ipc call mpris playPause >/dev/null 2>&1
                sleep 0.05
                m_status=$(playerctl status 2>/dev/null)
                m_title=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null)
                if [ "$m_status" = "Playing" ]; then
                    notify_osd "osd-media" "media-playback-start-symbolic" "Media Playing" "${m_title:-Playing}"
                else
                    notify_osd "osd-media" "media-playback-pause-symbolic" "Media Paused" "Paused"
                fi
                ;;
            next)
                dms ipc call mpris next >/dev/null 2>&1
                sleep 0.05
                m_title=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null)
                notify_osd "osd-media" "media-skip-forward-symbolic" "Next Track" "${m_title:-Next}"
                ;;
            prev)
                dms ipc call mpris previous >/dev/null 2>&1
                sleep 0.05
                m_title=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null)
                notify_osd "osd-media" "media-skip-backward-symbolic" "Previous Track" "${m_title:-Previous}"
                ;;
            stop)
                playerctl stop 2>/dev/null || dms ipc call mpris stop >/dev/null 2>&1
                notify_osd "osd-media" "media-playback-stop-symbolic" "Media" "Stopped"
                ;;
        esac
        ;;

    *)
        echo "Usage: $0 {touchpad [toggle|on|off]|volume [up|down|mute]|mic [mute]|brightness [up|down]|airplane [toggle]|display|media [play-pause|next|prev|stop]}" >&2
        exit 1
        ;;
esac
