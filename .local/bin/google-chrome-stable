#!/usr/bin/env bash
# Wrapper for Google Chrome to automatically load user flags from ~/.config/chrome-flags.conf

FLAGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/chrome-flags.conf"
FLAGS=()

if [ -f "$FLAGS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        # Strip leading and trailing whitespace
        trimmed="${line#"${line%%[![:space:]]*}"}"
        trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
        # Skip empty lines and comments
        if [[ -n "$trimmed" && ! "$trimmed" =~ ^# ]]; then
            FLAGS+=("$trimmed")
        fi
    done < "$FLAGS_FILE"
fi

# Locate the actual Google Chrome launcher or binary
REAL_CHROME="/opt/google/chrome/google-chrome"
if [ ! -x "$REAL_CHROME" ]; then
    REAL_CHROME="/opt/google/chrome/chrome"
fi

exec "$REAL_CHROME" "${FLAGS[@]}" "$@"
