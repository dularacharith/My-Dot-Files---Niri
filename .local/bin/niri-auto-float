#!/usr/bin/env python3
"""
niri-auto-float:
Smart dynamic window layout manager for Niri.
- Only ONE floating window stays floating at a time on an active workspace;
  clicking between multiple float windows alternates which one floats while the
  other docks into the 50% split next to the background window, looping back and forth.
- If a background window was in full screen / maximized, it stays in a 50% split
  while multiple float windows are active.
- When one float window is closed and only one is left, the remaining float window
  automatically restores to floating, and the minimized background window expands
  back to full screen / maximized.
- Clicking a background tiled window demotes floating windows to tiling so they never obstruct.
"""

import os
import sys
import json
import time
import socket
import signal
import logging

try:
    sys.stdout.reconfigure(line_buffering=True)
    sys.stderr.reconfigure(line_buffering=True)
except Exception:
    pass

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s'
)
log = logging.getLogger("niri-auto-float")

def get_niri_socket():
    sock = os.environ.get("NIRI_SOCKET")
    if sock and os.path.exists(sock):
        return sock
    uid = os.getuid()
    run_dir = f"/run/user/{uid}"
    if os.path.isdir(run_dir):
        for f in os.listdir(run_dir):
            if f.startswith("niri.") and f.endswith(".sock"):
                candidate = os.path.join(run_dir, f)
                if os.path.exists(candidate):
                    return candidate
    return None

class NiriAutoFloat:
    def __init__(self):
        self.sock_path = None
        self.s_cmd = None
        self.cmd_reader = None
        self.s_event = None
        self.event_reader = None
        self.running = True
        
        # Window IDs that should float when focused
        self.auto_float_ids = set()
        # Explicit user manual tiling overrides (Mod+Shift+T)
        self.manually_tiled_ids = set()
        # Track previous focused and floating states: wid -> (is_focused, is_floating)
        self.prev_win_states = {}
        # Track workspace split state: ws_id -> {'main_wid': int, 'mode': 'true_fullscreen' | 'maximized'}
        self.workspace_split_info = {}
        # Window ID for which demotion is temporarily suppressed until it regains focus
        self.suppress_demote_until_focus = None

    def connect(self):
        self.sock_path = get_niri_socket()
        if not self.sock_path:
            raise RuntimeError("NIRI_SOCKET not found")
            
        log.info(f"Connecting to Niri socket: {self.sock_path}")
        self.s_cmd = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s_cmd.connect(self.sock_path)
        self.cmd_reader = self.s_cmd.makefile('r')

        self.s_event = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s_event.connect(self.sock_path)
        self.s_event.sendall(b'"EventStream"\n')
        self.event_reader = self.s_event.makefile('r')

    def close(self):
        for s in (self.s_cmd, self.s_event):
            if s:
                try:
                    s.shutdown(socket.SHUT_RDWR)
                except Exception:
                    pass
                try:
                    s.close()
                except Exception:
                    pass
        self.s_cmd = None
        self.cmd_reader = None
        self.s_event = None
        self.event_reader = None

    def send_action(self, action_dict):
        try:
            if not self.s_cmd or not self.cmd_reader:
                return None
            if isinstance(action_dict, str):
                action_dict = {action_dict: {}}
            req = json.dumps({'Action': action_dict}) + '\n'
            self.s_cmd.sendall(req.encode())
            res = self.cmd_reader.readline()
            return json.loads(res) if res else None
        except Exception as e:
            log.warning(f"Error sending action {action_dict}: {e}")
            return None

    def get_windows(self):
        try:
            if not self.s_cmd or not self.cmd_reader:
                return None
            self.s_cmd.sendall(b'"Windows"\n')
            res = self.cmd_reader.readline()
            if not res:
                return None
            data = json.loads(res)
            return data.get('Ok', {}).get('Windows', [])
        except Exception as e:
            log.warning(f"Error querying windows: {e}")
            return None

    def get_workspaces(self):
        try:
            if not self.s_cmd or not self.cmd_reader:
                return []
            self.s_cmd.sendall(b'"Workspaces"\n')
            res = self.cmd_reader.readline()
            if not res:
                return []
            data = json.loads(res)
            return data.get('Ok', {}).get('Workspaces', [])
        except Exception as e:
            log.warning(f"Error querying workspaces: {e}")
            return []

    def get_outputs(self):
        try:
            if not self.s_cmd or not self.cmd_reader:
                return {}
            self.s_cmd.sendall(b'"Outputs"\n')
            res = self.cmd_reader.readline()
            if not res:
                return {}
            data = json.loads(res)
            return data.get('Ok', {}).get('Outputs', {})
        except Exception as e:
            log.warning(f"Error querying outputs: {e}")
            return {}

    def is_exempt(self, win):
        if not win:
            return True
        title = (win.get('title') or '').lower()
        app_id = (win.get('app_id') or '').lower()
        if 'picture-in-picture' in title or 'picture-in-picture' in app_id:
            return True
        if 'toast' in app_id or 'overlay' in app_id or 'polkit' in app_id or 'pinentry' in app_id or 'portal' in app_id:
            return True
        return False

    def is_default_floating(self, win):
        if not win:
            return False
        app_id = (win.get('app_id') or '').lower()
        return any(k in app_id for k in (
            'kitty', 'alacritty', 'ghostty', 'wezterm', 'vlc', 'haruna',
            'mpv', 'celluloid', 'showtime', 'decibels', 'totem', 'calculator',
            'galculator', 'blueman'
        ))

    def check_fullscreen(self, win, workspaces, outputs):
        if not win or win.get('is_floating'):
            return False, None
        ws_id = win.get('workspace_id')
        ws = next((w for w in workspaces if w.get('id') == ws_id), None)
        if not ws:
            return False, None
        out_name = ws.get('output')
        out = outputs.get(out_name, {}).get('logical')
        if not out:
            return False, None
        
        out_w = out.get('width', 1920)
        out_h = out.get('height', 1080)
        
        layout = win.get('layout') or {}
        tile_size = layout.get('tile_size') or [0, 0]
        window_size = layout.get('window_size') or [0, 0]

        w_width = max(tile_size[0], window_size[0])
        w_height = max(tile_size[1], window_size[1])

        # True fullscreen in Niri takes the full logical resolution (zero gaps)
        if w_width >= (out_w - 5) and w_height >= (out_h - 5):
            return True, 'true_fullscreen'
        
        # Maximized / full-width column takes >85% of screen width
        if w_width >= 0.85 * out_w:
            return True, 'maximized'
            
        return False, None

    def handle_update(self):
        windows = self.get_windows()
        if windows is None:
            return

        workspaces = self.get_workspaces()
        outputs = self.get_outputs()

        win_by_id = {w['id']: w for w in windows}
        focused = next((w for w in windows if w.get('is_focused')), None)
        if not focused:
            active_ws = next((ws for ws in workspaces if ws.get('is_focused') or ws.get('is_active')), None)
            if active_ws and active_ws.get('active_window_id'):
                focused = win_by_id.get(active_ws['active_window_id'])

        # Check suppression flag for temporary focus shifts during restoration
        if self.suppress_demote_until_focus is not None:
            if self.suppress_demote_until_focus not in win_by_id:
                self.suppress_demote_until_focus = None
            elif focused and focused.get('id') == self.suppress_demote_until_focus:
                log.info(f"Target window {self.suppress_demote_until_focus} regained focus; clearing suppress flag")
                self.suppress_demote_until_focus = None
            else:
                log.info(f"Suppressing auto-float actions while waiting for focus on {self.suppress_demote_until_focus}")
                return

        # 1. Clean up closed windows and handle window closure on split workspaces
        current_ids = set(win_by_id.keys())
        self.auto_float_ids.intersection_update(current_ids)
        self.manually_tiled_ids.intersection_update(current_ids)

        for ws_id in list(self.workspace_split_info.keys()):
            m_id = self.workspace_split_info[ws_id].get('main_wid')
            if m_id not in current_ids:
                self.workspace_split_info.pop(ws_id, None)
                continue

            # Check float windows remaining on this workspace
            ws_floats = [
                w for w in win_by_id.values()
                if w.get('workspace_id') == ws_id
                and (w['id'] in self.auto_float_ids or self.is_default_floating(w) or w.get('is_floating'))
                and w['id'] not in self.manually_tiled_ids
                and not self.is_exempt(w)
            ]

            # CASE A: Only 1 float window remains on this workspace
            if len(ws_floats) == 1:
                f_rem = ws_floats[0]
                f_rem_id = f_rem['id']
                split_info = self.workspace_split_info.pop(ws_id)
                mode = split_info.get('mode')
                log.info(f"Only 1 float window ({f_rem_id}) remains on ws {ws_id}; restoring {f_rem_id} to float and {m_id} to {mode}")

                # 1. Ensure the remaining window is floating
                if not f_rem.get('is_floating'):
                    self.send_action({'MoveWindowToFloating': {'id': f_rem_id}})
                    self.prev_win_states[f_rem_id] = (True, True)

                # 2. Restore the background window to maximized / fullscreen
                if m_id in win_by_id:
                    self.suppress_demote_until_focus = f_rem_id
                    self.send_action({'FocusWindow': {'id': m_id}})
                    if mode == 'true_fullscreen':
                        self.send_action({'FullscreenWindow': {'id': m_id}})
                    elif mode == 'maximized':
                        self.send_action({'SetColumnWidth': {'change': {'SetProportion': 100.0}}})
                        self.send_action({'MaximizeColumn': {}})
                    self.send_action({'FocusWindow': {'id': f_rem_id}})

            # CASE B: 0 float windows remain on this workspace
            elif len(ws_floats) == 0:
                split_info = self.workspace_split_info.pop(ws_id)
                mode = split_info.get('mode')
                log.info(f"0 float windows remain on ws {ws_id}; restoring background window {m_id} to {mode}")
                if m_id in win_by_id:
                    self.send_action({'FocusWindow': {'id': m_id}})
                    if mode == 'true_fullscreen':
                        self.send_action({'FullscreenWindow': {'id': m_id}})
                    elif mode == 'maximized':
                        self.send_action({'SetColumnWidth': {'change': {'SetProportion': 100.0}}})
                        self.send_action({'MaximizeColumn': {}})

        # 2. Track floating windows and respect explicit user manual tiling
        for wid, w in win_by_id.items():
            cur_focused = (focused is not None and focused.get('id') == wid)
            cur_floating = w.get('is_floating', False)

            if cur_floating and not self.is_exempt(w):
                if wid not in self.auto_float_ids:
                    self.auto_float_ids.add(wid)
                    self.manually_tiled_ids.discard(wid)
                    log.info(f"Tracking floating window {wid} ({w.get('app_id')})")
            elif self.is_default_floating(w) and wid not in self.manually_tiled_ids:
                if wid not in self.auto_float_ids:
                    self.auto_float_ids.add(wid)
                    log.info(f"Tracking default-floating window {wid} ({w.get('app_id')})")
            elif wid in self.prev_win_states:
                prev_focused, prev_floating = self.prev_win_states[wid]
                # If window was floating and user manually tiled it while focused (Mod+Shift+T):
                if prev_floating and not cur_floating and cur_focused:
                    self.auto_float_ids.discard(wid)
                    self.manually_tiled_ids.add(wid)
                    log.info(f"Window {wid} manually tiled while focused; removed from auto-float")

        # Update tracked states
        self.prev_win_states = {
            wid: (focused is not None and focused.get('id') == wid, w.get('is_floating', False))
            for wid, w in win_by_id.items()
        }

        if not focused:
            return

        f_id = focused['id']
        f_ws = focused.get('workspace_id')
        f_floating = focused.get('is_floating', False)

        # Classify windows on active workspace
        ws_wins = [w for w in win_by_id.values() if w.get('workspace_id') == f_ws]
        main_wins = [
            w for w in ws_wins
            if w['id'] not in self.auto_float_ids
            and not self.is_default_floating(w)
            and not w.get('is_floating')
            and not self.is_exempt(w)
        ]
        float_wins = [
            w for w in ws_wins
            if (w['id'] in self.auto_float_ids or self.is_default_floating(w) or w.get('is_floating'))
            and w['id'] not in self.manually_tiled_ids
            and not self.is_exempt(w)
        ]
        num_floats = len(float_wins)
        is_float_target = any(w['id'] == f_id for w in float_wins)

        # 3. IF FOCUSED WINDOW IS A FLOAT-CAPABLE WINDOW:
        if is_float_target:
            # Lift focused window to floating if it was tiled
            if not f_floating:
                log.info(f"Promoting focused window {f_id} ({focused.get('app_id')}) to floating!")
                self.send_action({'MoveWindowToFloating': {'id': f_id}})
                self.prev_win_states[f_id] = (True, True)

            # SUBCASE 3A: TWO OR MORE FLOAT WINDOWS ON THIS WORKSPACE
            # Maintain 50/50 split with background window, looping between the float windows
            if num_floats >= 2:
                # If there is a background main window not yet split, split it to 50%
                if main_wins and f_ws not in self.workspace_split_info:
                    main_win = main_wins[0]
                    m_id = main_win['id']
                    is_fs, fs_mode = self.check_fullscreen(main_win, workspaces, outputs)
                    if is_fs:
                        log.info(f"Background window {m_id} was {fs_mode}; splitting into half-screen")
                        self.workspace_split_info[f_ws] = {'main_wid': m_id, 'mode': fs_mode}
                        self.suppress_demote_until_focus = f_id
                        self.send_action({'FocusWindow': {'id': m_id}})
                        if fs_mode == 'true_fullscreen':
                            self.send_action({'FullscreenWindow': {'id': m_id}})
                        self.send_action({'SetColumnWidth': {'change': {'SetProportion': 50.0}}})
                        self.send_action({'FocusWindow': {'id': f_id}})

                # Demote any other float window on this workspace to 50% tiling
                for other in float_wins:
                    other_id = other['id']
                    if other_id != f_id:
                        log.info(f"Demoting other float window {other_id} ({other.get('app_id')}) to 50% split tile")
                        self.send_action({'MoveWindowToTiling': {'id': other_id}})
                        self.send_action({'SetColumnWidth': {'change': {'SetProportion': 50.0}}})
                        self.prev_win_states[other_id] = (False, False)

                # Center the split columns side-by-side
                self.send_action({'CenterVisibleColumns': {}})
                return

            # SUBCASE 3B: ONLY ONE FLOAT WINDOW LEFT ON THIS WORKSPACE
            # When one float window was closed and only one is left, restore the minimized window to maximized/fullscreen
            if num_floats == 1:
                if f_ws in self.workspace_split_info:
                    split_info = self.workspace_split_info.pop(f_ws)
                    m_id = split_info.get('main_wid')
                    mode = split_info.get('mode')
                    if m_id in win_by_id:
                        is_m_fs, _ = self.check_fullscreen(win_by_id[m_id], workspaces, outputs)
                        if not is_m_fs:
                            log.info(f"Only 1 float window left; restoring minimized window {m_id} to {mode}")
                            self.suppress_demote_until_focus = f_id
                            self.send_action({'FocusWindow': {'id': m_id}})
                            if mode == 'true_fullscreen':
                                self.send_action({'FullscreenWindow': {'id': m_id}})
                            elif mode == 'maximized':
                                self.send_action({'SetColumnWidth': {'change': {'SetProportion': 100.0}}})
                                self.send_action({'MaximizeColumn': {}})
                            self.send_action({'FocusWindow': {'id': f_id}})
                return

        # 4. IF FOCUSED WINDOW IS A TILED BACKGROUND WINDOW:
        if not f_floating and not is_float_target:
            if num_floats > 0 and f_ws not in self.workspace_split_info:
                is_fs, fs_mode = self.check_fullscreen(focused, workspaces, outputs)
                if is_fs:
                    log.info(f"Focused background window {f_id} was {fs_mode}; splitting into half-screen")
                    self.workspace_split_info[f_ws] = {'main_wid': f_id, 'mode': fs_mode}
                    if fs_mode == 'true_fullscreen':
                        self.send_action({'FullscreenWindow': {'id': f_id}})
                    self.send_action({'SetColumnWidth': {'change': {'SetProportion': 50.0}}})

            # Demote any floating window on this workspace to tiling
            for w in float_wins:
                wid = w['id']
                if w.get('is_floating'):
                    log.info(f"Demoting floating window {wid} ({w.get('app_id')}) to 50% tiling layout")
                    self.auto_float_ids.add(wid)
                    self.send_action({'MoveWindowToTiling': {'id': wid}})
                    self.send_action({'SetColumnWidth': {'change': {'SetProportion': 50.0}}})
                    self.prev_win_states[wid] = (False, False)

            if num_floats > 0:
                self.send_action({'CenterVisibleColumns': {}})

    def run(self):
        log.info("Starting Niri Auto-Float Daemon...")
        while self.running:
            try:
                self.connect()
                # Consume handshake
                handshake = self.event_reader.readline()
                log.info(f"EventStream handshake: {handshake.strip() if handshake else 'None'}")

                # Initial state sync
                self.handle_update()

                while self.running:
                    line = self.event_reader.readline()
                    if not line:
                        break
                    line = line.strip()
                    if not line:
                        continue
                    log.info(f"Event received: {line[:100]}")
                    try:
                        data = json.loads(line)
                        k = list(data.keys())[0]
                        if k in (
                            "WindowOpenedOrChanged",
                            "WindowClosed",
                            "WindowFocusChanged",
                            "WorkspaceActiveWindowChanged",
                            "WorkspacesChanged",
                            "WindowsChanged",
                            "WindowLayoutsChanged"
                        ):
                            self.handle_update()
                    except Exception as e:
                        log.debug(f"Event parse error: {e}")
            except Exception as e:
                log.warning(f"Connection lost or error: {e}. Reconnecting in 1s...")
                self.close()
                time.sleep(1.0)

def main():
    daemon = NiriAutoFloat()

    def handle_signal(sig, frame):
        log.info(f"Caught signal {sig}, exiting...")
        daemon.running = False
        daemon.close()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    daemon.run()

if __name__ == "__main__":
    main()
