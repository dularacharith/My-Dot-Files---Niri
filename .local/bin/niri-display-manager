#!/usr/bin/env python3
"""
Niri Display Manager (niri-display-manager)
Modern GTK4 / Libadwaita GUI to manage monitor resolutions, scaling, multi-monitor
extensions (Left, Right, Top, Bottom), and hardware-accelerated display mirroring.
Bound to Mod+P in Niri with instant toggle support.
"""

import os
import sys
import json
import signal
import subprocess
from pathlib import Path

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, Gio, GLib, Gdk
import cairo

APP_ID = "com.dms.displaymanager"
OUTPUTS_KDL_PATH = Path.home() / ".config" / "niri" / "dms" / "outputs.kdl"


PID_FILE = Path(f"/run/user/{os.getuid()}/niri-display-manager.pid")


def check_single_instance_toggle():
    """If an existing instance is running, signal it to exit and terminate (toggle behavior)."""
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            cmdline_path = Path(f"/proc/{pid}/cmdline")
            # If the process is alive and is actually niri-display-manager, toggle off
            if cmdline_path.exists() and "niri-display-manager" in cmdline_path.read_text():
                os.kill(pid, signal.SIGTERM)
                try:
                    PID_FILE.unlink(missing_ok=True)
                except Exception:
                    pass
                sys.exit(0)
            else:
                # Stale PID file
                try:
                    PID_FILE.unlink(missing_ok=True)
                except Exception:
                    pass
        except Exception:
            try:
                PID_FILE.unlink(missing_ok=True)
            except Exception:
                pass

    try:
        PID_FILE.write_text(str(os.getpid()))
    except Exception:
        pass


def cleanup_pid_file():
    try:
        PID_FILE.unlink(missing_ok=True)
    except Exception:
        pass


class NiriDisplayBackend:
    """Interface to communicate with Niri and manage output configurations."""

    @staticmethod
    def get_outputs():
        """Retrieve connected displays and current settings from niri."""
        try:
            res = subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True, text=True, check=True)
            return json.loads(res.stdout)
        except Exception as e:
            print(f"[Backend] Error querying niri outputs: {e}", file=sys.stderr)
            return {}

    @staticmethod
    def is_mirroring_active():
        """Check if wl-mirror is currently active."""
        res = subprocess.run(["pgrep", "-x", "wl-mirror"], capture_output=True)
        return res.returncode == 0

    @staticmethod
    def stop_mirroring():
        """Stop all running wl-mirror instances."""
        subprocess.run(["pkill", "-x", "wl-mirror"], capture_output=True)

    @staticmethod
    def start_mirroring(target_output, source_output):
        """Start mirroring source_output onto target_output using wl-mirror."""
        NiriDisplayBackend.stop_mirroring()
        try:
            subprocess.Popen([
                "wl-mirror",
                "--fullscreen-output", target_output,
                source_output
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception as e:
            print(f"[Backend] Failed to start wl-mirror: {e}", file=sys.stderr)
            return False

    @staticmethod
    def apply_output_live(output_name, mode=None, scale=None, pos_x=None, pos_y=None, transform=None, off=False):
        """Apply temporary live settings immediately via niri msg output."""
        try:
            if off:
                subprocess.run(["niri", "msg", "output", output_name, "off"], capture_output=True)
                return
            else:
                subprocess.run(["niri", "msg", "output", output_name, "on"], capture_output=True)

            if mode:
                subprocess.run(["niri", "msg", "output", output_name, "mode", str(mode)], capture_output=True)
            if scale is not None:
                subprocess.run(["niri", "msg", "output", output_name, "scale", str(scale)], capture_output=True)
            if pos_x is not None and pos_y is not None:
                subprocess.run(["niri", "msg", "output", output_name, "position", "set", str(int(pos_x)), str(int(pos_y))], capture_output=True)
            if transform:
                subprocess.run(["niri", "msg", "output", output_name, "transform", str(transform)], capture_output=True)
        except Exception as e:
            print(f"[Backend] Failed applying live output for {output_name}: {e}", file=sys.stderr)

    @staticmethod
    def save_outputs_kdl(outputs_data):
        """Save the given output configuration dict permanently into outputs.kdl."""
        OUTPUTS_KDL_PATH.parent.mkdir(parents=True, exist_ok=True)
        lines = [
            "// Auto-generated by Niri Display Manager",
            ""
        ]

        for name, data in outputs_data.items():
            lines.append(f'output "{name}" {{')
            if data.get("off", False):
                lines.append("    off")
            else:
                if data.get("mode"):
                    lines.append(f'    mode "{data["mode"]}"')
                if data.get("scale") is not None:
                    lines.append(f'    scale {data["scale"]}')
                if data.get("pos_x") is not None and data.get("pos_y") is not None:
                    lines.append(f'    position x={int(data["pos_x"])} y={int(data["pos_y"])}')
                if data.get("transform") and data.get("transform") != "normal":
                    lines.append(f'    transform "{data["transform"]}"')
            lines.append("}")
            lines.append("")

        content = "\n".join(lines)
        OUTPUTS_KDL_PATH.write_text(content)

    @staticmethod
    def notify_dms_toast(message, icon="desktop_windows"):
        """Display a subtle toast via DMS ToastService."""
        try:
            subprocess.run([
                "dms", "ipc", "call", "toast", "infoWith",
                str(message), "", "", str(icon)
            ], capture_output=True)
        except Exception:
            pass


class MonitorCanvas(Gtk.DrawingArea):
    """Visual canvas rendering interactive monitor layouts."""

    def __init__(self, on_monitor_selected_cb):
        super().__init__()
        self.set_content_height(125)
        self.set_hexpand(True)
        self.on_monitor_selected_cb = on_monitor_selected_cb

        self.outputs = {}
        self.selected_output = None
        self.boxes = {}  # output_name -> (x, y, w, h)

        self.set_draw_func(self.draw)

        click = Gtk.GestureClick.new()
        click.connect("pressed", self.on_click)
        self.add_controller(click)

    def update_outputs(self, outputs, selected_output):
        self.outputs = outputs
        self.selected_output = selected_output
        self.queue_draw()

    def on_click(self, gesture, n_press, x, y):
        for name, (bx, by, bw, bh) in self.boxes.items():
            if bx <= x <= bx + bw and by <= y <= by + bh:
                self.selected_output = name
                self.queue_draw()
                if self.on_monitor_selected_cb:
                    self.on_monitor_selected_cb(name)
                break

    def draw(self, area, cr, width, height):
        self.boxes.clear()

        # Canvas container background
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.06)
        cr.save()
        self._rounded_rectangle(cr, 6, 6, width - 12, height - 12, 10)
        cr.fill()
        cr.restore()

        if not self.outputs:
            cr.set_source_rgba(0.5, 0.5, 0.5, 0.8)
            cr.select_font_face("Inter, Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(13)
            cr.move_to(width / 2 - 60, height / 2)
            cr.show_text("No displays detected")
            return

        # Calculate bounding box of all displays in logical coordinates
        active_monitors = []
        for name, data in self.outputs.items():
            log = data.get("logical") or {}
            x = log.get("x", 0)
            y = log.get("y", 0)
            lw = log.get("width", 1920)
            lh = log.get("height", 1080)
            scale = log.get("scale", 1.0)
            active_monitors.append({
                "name": name,
                "x": x, "y": y,
                "w": lw, "h": lh,
                "scale": scale,
                "data": data
            })

        min_x = min(m["x"] for m in active_monitors)
        max_x = max(m["x"] + m["w"] for m in active_monitors)
        min_y = min(m["y"] for m in active_monitors)
        max_y = max(m["y"] + m["h"] for m in active_monitors)

        total_w = max(1, max_x - min_x)
        total_h = max(1, max_y - min_y)

        # Scale factor to fit within drawing canvas with margins
        margin_x = 24
        margin_y = 16
        avail_w = width - (margin_x * 2)
        avail_h = height - (margin_y * 2)
        scale_fit = min(avail_w / total_w, avail_h / total_h)

        offset_x = (width - (total_w * scale_fit)) / 2
        offset_y = (height - (total_h * scale_fit)) / 2

        # Draw each monitor
        for m in active_monitors:
            name = m["name"]
            is_selected = (name == self.selected_output)
            is_primary = (name == "eDP-1" or m["x"] == 0)

            dx = offset_x + (m["x"] - min_x) * scale_fit
            dy = offset_y + (m["y"] - min_y) * scale_fit
            dw = m["w"] * scale_fit
            dh = m["h"] * scale_fit

            self.boxes[name] = (dx, dy, dw, dh)

            # Monitor body
            cr.save()
            self._rounded_rectangle(cr, dx, dy, dw, dh, 8)
            if is_selected:
                cr.set_source_rgba(0.40, 0.31, 0.64, 0.22)
            else:
                cr.set_source_rgba(0.0, 0.0, 0.0, 0.12)
            cr.fill_preserve()

            # Border
            if is_selected:
                cr.set_source_rgba(0.40, 0.31, 0.64, 0.95)
                cr.set_line_width(2.2)
            else:
                cr.set_source_rgba(0.5, 0.5, 0.5, 0.35)
                cr.set_line_width(1.0)
            cr.stroke()
            cr.restore()

            # Text inside monitor
            cr.save()
            is_dark = Adw.StyleManager.get_default().get_dark()
            cr.set_source_rgba(0.12, 0.12, 0.12, 0.95) if not is_dark else cr.set_source_rgba(0.95, 0.95, 0.95, 0.95)
            cr.select_font_face("Inter, Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(max(10, min(13, int(dh * 0.24))))

            text_title = f"{name}" + (" ★" if is_primary else "")
            ext = cr.text_extents(text_title)
            cr.move_to(dx + (dw - ext.width) / 2, dy + (dh / 2) - 3)
            cr.show_text(text_title)

            # Subtitle (Resolution & Scale)
            cr.select_font_face("Inter, Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(max(9, min(11, int(dh * 0.18))))
            cr.set_source_rgba(0.5, 0.5, 0.5, 0.85)
            text_sub = f"{int(m['w'] * m['scale'])}×{int(m['h'] * m['scale'])} • {int(m['scale'] * 100)}%"
            ext_sub = cr.text_extents(text_sub)
            cr.move_to(dx + (dw - ext_sub.width) / 2, dy + (dh / 2) + ext_sub.height + 4)
            cr.show_text(text_sub)
            cr.restore()

    def _rounded_rectangle(self, cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -1.5707963, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.5707963)
        cr.arc(x + r, y + h - r, r, 1.5707963, 3.1415926)
        cr.arc(x + r, y + r, r, 3.1415926, 4.7123889)
        cr.close_path()


class DisplayManagerWindow(Adw.ApplicationWindow):
    """Main Display Manager Window."""

    def __init__(self, application):
        super().__init__(application=application)
        self.set_title("Display Manager")
        self.set_default_size(860, 720)

        # Allow pressing Escape to close
        key_ctrl = Gtk.EventControllerKey.new()
        key_ctrl.connect("key-pressed", self.on_key_pressed)
        self.add_controller(key_ctrl)

        self.backend = NiriDisplayBackend()
        self.raw_outputs = {}
        self.selected_output_name = None
        self.current_settings = {}
        self.suppress_signals = False

        self._build_ui()
        self.reload_data()

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def _build_ui(self):
        # Root layout with ToastOverlay
        self.toast_overlay = Adw.ToastOverlay.new()
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toast_overlay.set_child(main_box)
        self.set_content(self.toast_overlay)

        # Headerbar
        header = Adw.HeaderBar.new()
        self.title_widget = Adw.WindowTitle.new("Display Manager", "Configuring Displays")
        header.set_title_widget(self.title_widget)

        refresh_btn = Gtk.Button.new_from_icon_name("view-refresh-symbolic")
        refresh_btn.set_tooltip_text("Detect / Refresh Displays")
        refresh_btn.connect("clicked", lambda b: self.reload_data(show_toast=True))
        header.pack_start(refresh_btn)

        main_box.append(header)

        # Active Mirroring Banner
        self.banner = Adw.Banner.new("Screen Mirroring Active")
        self.banner.set_button_label("Stop Mirroring")
        self.banner.connect("button-clicked", self.on_stop_mirroring_clicked)
        main_box.append(self.banner)

        # Scrolled Window
        scrolled = Gtk.ScrolledWindow.new()
        scrolled.set_vexpand(True)
        main_box.append(scrolled)

        clamp = Adw.Clamp.new()
        clamp.set_maximum_size(840)
        clamp.set_tightening_threshold(660)
        scrolled.set_child(clamp)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content_box.set_margin_top(12)
        content_box.set_margin_bottom(20)
        content_box.set_margin_start(16)
        content_box.set_margin_end(16)
        clamp.set_child(content_box)

        # 1. Visual Monitor Canvas
        self.canvas = MonitorCanvas(on_monitor_selected_cb=self.on_canvas_monitor_selected)
        content_box.append(self.canvas)

        # 2. Selected Display Settings Group (Always accessible, even with 1 monitor!)
        self.settings_group = Adw.PreferencesGroup.new()
        self.settings_group.set_title("Display Settings")
        self.settings_group.set_description("Control resolution, refresh rate, and scaling for the active display")
        content_box.append(self.settings_group)

        # Resolution Dropdown
        self.res_model = Gtk.StringList.new([])
        self.res_row = Adw.ComboRow.new()
        self.res_row.set_title("Resolution & Refresh Rate")
        self.res_row.set_subtitle("Hardware display modes")
        self.res_row.add_prefix(Gtk.Image.new_from_icon_name("video-display-symbolic"))
        self.res_row.set_model(self.res_model)
        self.res_row.connect("notify::selected", self.on_resolution_changed)
        self.settings_group.add(self.res_row)

        # Scaling ActionRow
        self.scale_row = Adw.ActionRow.new()
        self.scale_row.set_title("Display Scale")
        self.scale_row.set_subtitle("Adjust interface and font scaling factor")
        self.scale_row.add_prefix(Gtk.Image.new_from_icon_name("zoom-original-symbolic"))
        self.settings_group.add(self.scale_row)

        # Scale preset pills
        scale_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        scale_box.set_valign(Gtk.Align.CENTER)
        self.scale_row.add_suffix(scale_box)

        for s_val, s_label in [(1.0, "100%"), (1.25, "125%"), (1.5, "150%"), (2.0, "200%")]:
            b = Gtk.Button.new_with_label(s_label)
            b.add_css_class("pill")
            b.connect("clicked", lambda btn, s=s_val: self.on_scale_preset_clicked(s))
            scale_box.append(b)

        # Precise scale spinbutton
        adj = Gtk.Adjustment.new(1.25, 0.5, 3.0, 0.05, 0.25, 0)
        self.scale_spin = Gtk.SpinButton.new(adj, 0.05, 2)
        self.scale_spin.set_valign(Gtk.Align.CENTER)
        self.scale_spin.connect("value-changed", self.on_scale_spin_changed)
        scale_box.append(self.scale_spin)

        # Orientation Dropdown
        self.orient_model = Gtk.StringList.new([
            "Landscape (0°)",
            "Portrait (90° Clockwise)",
            "Landscape Inverted (180°)",
            "Portrait Inverted (270°)"
        ])
        self.orient_row = Adw.ComboRow.new()
        self.orient_row.set_title("Orientation")
        self.orient_row.set_subtitle("Display rotation")
        self.orient_row.add_prefix(Gtk.Image.new_from_icon_name("object-rotate-right-symbolic"))
        self.orient_row.set_model(self.orient_model)
        self.orient_row.connect("notify::selected", self.on_orientation_changed)
        self.settings_group.add(self.orient_row)

        # Display Power Switch
        self.power_row = Adw.SwitchRow.new()
        self.power_row.set_title("Display Active")
        self.power_row.set_subtitle("Turn this screen on or off")
        self.power_row.add_prefix(Gtk.Image.new_from_icon_name("preferences-desktop-display-symbolic"))
        self.power_row.connect("notify::active", self.on_power_changed)
        self.settings_group.add(self.power_row)

        # 3. Multi-Monitor Arrangement Presets Group
        self.arrangement_group = Adw.PreferencesGroup.new()
        self.arrangement_group.set_title("Multi-Monitor Arrangement")
        self.arrangement_group.set_description("Configure monitor position, extension, or screen duplication")
        content_box.append(self.arrangement_group)

        arrangement_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.arrangement_group.add(arrangement_card)

        grid = Gtk.Grid.new()
        grid.set_column_spacing(8)
        grid.set_row_spacing(8)
        grid.set_column_homogeneous(True)
        grid.set_row_homogeneous(True)
        arrangement_card.append(grid)

        # Preset Cards
        presets = [
            ("extend-right", "Extend Right", "pan-end-symbolic", "Secondary to the right", 0, 0),
            ("extend-left", "Extend Left", "pan-start-symbolic", "Secondary to the left", 1, 0),
            ("extend-top", "Extend Top", "go-up-symbolic", "Secondary above primary", 0, 1),
            ("extend-bottom", "Extend Bottom", "go-down-symbolic", "Secondary below primary", 1, 1),
            ("mirror", "Duplicate Screen", "view-mirror-symbolic", "Mirror primary to secondary", 0, 2),
            ("pc-only", "PC Screen Only", "video-display-symbolic", "Disable external screens", 1, 2),
        ]

        for p_id, p_title, p_icon, p_desc, col, row in presets:
            btn = self._create_preset_card(p_id, p_title, p_icon, p_desc)
            grid.attach(btn, col, row, 1, 1)

        # Bottom Action Bar
        action_bar = Gtk.ActionBar.new()
        main_box.append(action_bar)

        apply_btn = Gtk.Button.new_with_label("Apply & Save")
        apply_btn.add_css_class("suggested-action")
        apply_btn.connect("clicked", lambda b: self.save_all_settings())
        action_bar.pack_end(apply_btn)

        close_btn = Gtk.Button.new_with_label("Close")
        close_btn.connect("clicked", lambda b: self.close())
        action_bar.pack_start(close_btn)

    def _create_preset_card(self, p_id, p_title, p_icon, p_desc):
        btn = Gtk.Button.new()
        btn.add_css_class("card")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(10)
        box.set_margin_end(10)

        icon = Gtk.Image.new_from_icon_name(p_icon)
        icon.set_pixel_size(20)
        box.append(icon)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label.new(p_title)
        title_lbl.set_halign(Gtk.Align.START)
        title_lbl.add_css_class("heading")
        text_box.append(title_lbl)

        desc_lbl = Gtk.Label.new(p_desc)
        desc_lbl.set_halign(Gtk.Align.START)
        desc_lbl.add_css_class("caption")
        desc_lbl.add_css_class("dim-label")
        text_box.append(desc_lbl)

        box.append(text_box)
        btn.set_child(box)
        btn.connect("clicked", lambda b, pid=p_id: self.on_preset_clicked(pid))
        return btn

    def reload_data(self, show_toast=False):
        """Fetch outputs from Niri and refresh the UI state."""
        self.suppress_signals = True
        self.raw_outputs = self.backend.get_outputs()

        # Update Mirroring Banner
        mirror_active = self.backend.is_mirroring_active()
        self.banner.set_revealed(mirror_active)

        count = len(self.raw_outputs)
        if count == 0:
            self.title_widget.set_subtitle("No Displays Detected")
        elif count == 1:
            name = list(self.raw_outputs.keys())[0]
            self.title_widget.set_subtitle(f"Single Display: {name}")
        else:
            self.title_widget.set_subtitle(f"{count} Displays Connected")

        # Select primary or first output if not set or invalid
        if not self.selected_output_name or self.selected_output_name not in self.raw_outputs:
            if "eDP-1" in self.raw_outputs:
                self.selected_output_name = "eDP-1"
            elif self.raw_outputs:
                self.selected_output_name = list(self.raw_outputs.keys())[0]

        # Populate current_settings from raw_outputs if empty
        for name, data in self.raw_outputs.items():
            if name not in self.current_settings:
                log = data.get("logical") or {}
                modes = data.get("modes", [])
                cur_mode_idx = data.get("current_mode", 0)
                cur_mode_str = ""
                if modes and 0 <= cur_mode_idx < len(modes):
                    m = modes[cur_mode_idx]
                    cur_mode_str = f"{m['width']}x{m['height']}@{round(m['refresh_rate'] / 1000, 3)}"

                self.current_settings[name] = {
                    "mode": cur_mode_str,
                    "scale": log.get("scale", 1.0),
                    "pos_x": log.get("x", 0),
                    "pos_y": log.get("y", 0),
                    "transform": log.get("transform", "Normal").lower(),
                    "off": (data.get("logical") is None)
                }

        # Update visual canvas
        self.canvas.update_outputs(self.raw_outputs, self.selected_output_name)

        # Update multi-monitor arrangement card visibility / sensitivity
        self.arrangement_group.set_sensitive(count >= 2)
        if count < 2:
            self.arrangement_group.set_description("Connect an external monitor via HDMI or DisplayPort to enable Multi-Monitor arrangements")
        else:
            self.arrangement_group.set_description("Select an arrangement layout to position or duplicate displays")

        # Update selected monitor controls
        self._update_selected_monitor_controls()
        self.suppress_signals = False

        if show_toast:
            self.toast_overlay.add_toast(Adw.Toast.new("Display list refreshed"))

    def on_canvas_monitor_selected(self, monitor_name):
        self.selected_output_name = monitor_name
        self.suppress_signals = True
        self._update_selected_monitor_controls()
        self.suppress_signals = False

    def _update_selected_monitor_controls(self):
        if not self.selected_output_name or self.selected_output_name not in self.raw_outputs:
            return

        out_data = self.raw_outputs[self.selected_output_name]
        cfg = self.current_settings.get(self.selected_output_name, {})

        model_name = f"{out_data.get('make', '')} {out_data.get('model', '')}".strip()
        self.settings_group.set_title(f"Display Settings — {self.selected_output_name}" + (f" ({model_name})" if model_name else ""))

        # Power switch
        is_only_screen = (len(self.raw_outputs) <= 1)
        self.power_row.set_sensitive(not is_only_screen)
        self.power_row.set_active(not cfg.get("off", False))
        if is_only_screen:
            self.power_row.set_subtitle("Primary active screen (Cannot be disabled)")
        else:
            self.power_row.set_subtitle("Turn this display on or off")

        # Resolution dropdown
        modes = out_data.get("modes", [])
        self.mode_strings = []
        labels = []
        selected_idx = 0

        for idx, m in enumerate(modes):
            w = m.get("width")
            h = m.get("height")
            hz = round(m.get("refresh_rate", 60000) / 1000, 2)
            pref = " (Preferred)" if m.get("is_preferred") else ""
            mode_str = f"{w}x{h}@{round(m.get('refresh_rate') / 1000, 3)}"
            self.mode_strings.append(mode_str)
            labels.append(f"{w} × {h} @ {hz} Hz{pref}")

            if cfg.get("mode") and (cfg["mode"] == mode_str or cfg["mode"].startswith(f"{w}x{h}")):
                selected_idx = idx

        self.res_model.splice(0, self.res_model.get_n_items(), labels)
        if labels:
            self.res_row.set_selected(selected_idx)

        # Scale
        current_scale = cfg.get("scale", 1.0)
        self.scale_spin.set_value(current_scale)

        # Orientation
        transform_map = {"normal": 0, "90": 1, "180": 2, "270": 3}
        t_val = cfg.get("transform", "normal").lower()
        self.orient_row.set_selected(transform_map.get(t_val, 0))

    def on_power_changed(self, switch, gparam):
        if self.suppress_signals or not self.selected_output_name:
            return
        is_on = self.power_row.get_active()
        self.current_settings[self.selected_output_name]["off"] = not is_on
        self.backend.apply_output_live(self.selected_output_name, off=(not is_on))
        self.canvas.queue_draw()

    def on_resolution_changed(self, combo, gparam):
        if self.suppress_signals or not self.selected_output_name:
            return
        idx = self.res_row.get_selected()
        if 0 <= idx < len(self.mode_strings):
            mode_val = self.mode_strings[idx]
            self.current_settings[self.selected_output_name]["mode"] = mode_val
            self.backend.apply_output_live(self.selected_output_name, mode=mode_val)
            self.toast_overlay.add_toast(Adw.Toast.new(f"Resolution set: {mode_val}"))
            self.canvas.queue_draw()

    def on_scale_preset_clicked(self, scale_val):
        if not self.selected_output_name:
            return
        self.scale_spin.set_value(scale_val)

    def on_scale_spin_changed(self, spin):
        if self.suppress_signals or not self.selected_output_name:
            return
        scale_val = round(self.scale_spin.get_value(), 2)
        self.current_settings[self.selected_output_name]["scale"] = scale_val
        self.backend.apply_output_live(self.selected_output_name, scale=scale_val)
        self.canvas.queue_draw()

    def on_orientation_changed(self, combo, gparam):
        if self.suppress_signals or not self.selected_output_name:
            return
        idx = self.orient_row.get_selected()
        t_values = ["normal", "90", "180", "270"]
        t_val = t_values[idx]
        self.current_settings[self.selected_output_name]["transform"] = t_val
        self.backend.apply_output_live(self.selected_output_name, transform=t_val)
        self.canvas.queue_draw()

    def on_preset_clicked(self, preset_id):
        """Handle Multi-Monitor arrangement presets."""
        monitors = list(self.raw_outputs.keys())
        if len(monitors) < 2 and preset_id != "pc-only":
            self.toast_overlay.add_toast(Adw.Toast.new("Connect an external display to use this preset"))
            return

        primary = "eDP-1" if "eDP-1" in self.raw_outputs else monitors[0]
        secondaries = [m for m in monitors if m != primary]
        sec = secondaries[0] if secondaries else primary

        p_log = self.raw_outputs[primary].get("logical") or {}
        s_log = self.raw_outputs[sec].get("logical") or {}

        p_lw = p_log.get("width", 1920)
        p_lh = p_log.get("height", 1080)
        s_lw = s_log.get("width", 1920)
        s_lh = s_log.get("height", 1080)

        if preset_id == "extend-right":
            self.backend.stop_mirroring()
            self.banner.set_revealed(False)
            self._set_pos(primary, 0, 0, off=False)
            self._set_pos(sec, p_lw, 0, off=False)
            self.toast_overlay.add_toast(Adw.Toast.new("Extended display to the right"))
            self.backend.notify_dms_toast("Displays Extended Right", "pan-end-symbolic")

        elif preset_id == "extend-left":
            self.backend.stop_mirroring()
            self.banner.set_revealed(False)
            self._set_pos(sec, 0, 0, off=False)
            self._set_pos(primary, s_lw, 0, off=False)
            self.toast_overlay.add_toast(Adw.Toast.new("Extended display to the left"))
            self.backend.notify_dms_toast("Displays Extended Left", "pan-start-symbolic")

        elif preset_id == "extend-top":
            self.backend.stop_mirroring()
            self.banner.set_revealed(False)
            self._set_pos(sec, 0, 0, off=False)
            self._set_pos(primary, 0, s_lh, off=False)
            self.toast_overlay.add_toast(Adw.Toast.new("Extended display above"))
            self.backend.notify_dms_toast("Displays Extended Above", "go-up-symbolic")

        elif preset_id == "extend-bottom":
            self.backend.stop_mirroring()
            self.banner.set_revealed(False)
            self._set_pos(primary, 0, 0, off=False)
            self._set_pos(sec, 0, p_lh, off=False)
            self.toast_overlay.add_toast(Adw.Toast.new("Extended display below"))
            self.backend.notify_dms_toast("Displays Extended Below", "go-down-symbolic")

        elif preset_id == "mirror":
            ok = self.backend.start_mirroring(sec, primary)
            if ok:
                self.banner.set_title(f"Mirroring Active: {primary} → {sec}")
                self.banner.set_revealed(True)
                self.toast_overlay.add_toast(Adw.Toast.new(f"Mirroring {primary} to {sec}"))
                self.backend.notify_dms_toast(f"Mirroring to {sec}", "view-mirror-symbolic")
            else:
                self.toast_overlay.add_toast(Adw.Toast.new("Failed to start display mirroring"))

        elif preset_id == "pc-only":
            self.backend.stop_mirroring()
            self.banner.set_revealed(False)
            self._set_pos(primary, 0, 0, off=False)
            for s in secondaries:
                self._set_pos(s, 0, 0, off=True)
            self.toast_overlay.add_toast(Adw.Toast.new("PC Screen Only (External displays disabled)"))
            self.backend.notify_dms_toast("PC Screen Only", "video-display-symbolic")

        self.save_all_settings(silent=True)
        self.canvas.update_outputs(self.raw_outputs, self.selected_output_name)

    def _set_pos(self, name, x, y, off=False):
        if name not in self.current_settings:
            self.current_settings[name] = {}
        self.current_settings[name]["pos_x"] = x
        self.current_settings[name]["pos_y"] = y
        self.current_settings[name]["off"] = off
        self.backend.apply_output_live(name, pos_x=x, pos_y=y, off=off)

    def on_stop_mirroring_clicked(self, banner):
        self.backend.stop_mirroring()
        self.banner.set_revealed(False)
        self.toast_overlay.add_toast(Adw.Toast.new("Display mirroring stopped"))
        self.backend.notify_dms_toast("Mirroring Stopped", "desktop_windows")

    def save_all_settings(self, silent=False):
        """Save settings permanently to ~/.config/niri/dms/outputs.kdl."""
        self.backend.save_outputs_kdl(self.current_settings)
        if not silent:
            self.toast_overlay.add_toast(Adw.Toast.new("Display settings saved permanently"))
            self.backend.notify_dms_toast("Display Settings Saved", "desktop_windows")


class DisplayManagerApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )
        self.window = None

    def do_activate(self):
        if self.window is not None:
            self.window.present()
            return

        self.window = DisplayManagerWindow(application=self)
        self.window.connect("close-request", self.on_window_close)
        self.window.present()

    def on_window_close(self, win):
        self.window = None
        cleanup_pid_file()
        self.quit()
        return False


def main():
    check_single_instance_toggle()
    GLib.set_prgname(APP_ID)
    GLib.set_application_name("Display Manager")
    app = DisplayManagerApp()

    # Handle SIGTERM cleanly
    def on_sigterm(s, f):
        cleanup_pid_file()
        app.quit()

    signal.signal(signal.SIGTERM, on_sigterm)

    try:
        sys.exit(app.run(sys.argv))
    finally:
        cleanup_pid_file()


if __name__ == "__main__":
    main()
